DATABASE_URL=postgresql://user:senha@localhost:5432/ecomerce
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:54329/ecomerce_test
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
# Sem Vercel Blob (VPS): STORAGE=local e UPLOADS_DIR apontando para um volume
STORAGE=
UPLOADS_DIR=
SEED_MASTER_EMAIL=master@exemplo.com
SEED_MASTER_PASSWORD=
PLATFORM_DOMAIN=localhost
BILLING_MP_ACCESS_TOKEN=
BILLING_WEBHOOK_SECRET=
CRON_SECRET=
# Chave das credenciais das lojas (AES-256-GCM): 64 caracteres hex (32 bytes). Gere com: openssl rand -hex 32
CREDENTIALS_KEY=
# Alvo do CNAME do dominio proprio das lojas (padrao: cname.vercel-dns.com)
PLATFORM_CNAME_TARGET=cname.vercel-dns.com
# E-mail transacional (SMTP). Ex.: smtps://resend:SENHA@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=Loja <no-reply@seudominio.com.br>
