generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum MemberRole {
  OWNER
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

// ---------- plataforma (sem storeId) ----------

model Account {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  isMaster     Boolean       @default(false)
  memberships  StoreMember[]
}

model Plan {
  id                String  @id @default(cuid())
  name              String  @unique
  priceCents        Int
  productLimit      Int?
  staffLimit        Int
  customDomain      Boolean
  advancedMetrics   Boolean
  csvExport         Boolean
  transactionFeeBps Int     @default(0)
  active            Boolean @default(true)
  stores            Store[]
}

model Store {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  status            StoreStatus    @default(TRIAL)
  planId            String
  plan              Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  trialEndsAt       DateTime?
  graceEndsAt       DateTime?
  /// Suspensa pelo master: evento de cobranca nao reativa; so o master libera.
  suspendedByMaster Boolean        @default(false)
  createdAt         DateTime       @default(now())
  members           StoreMember[]
  domains           StoreDomain[]
  subscription      Subscription?
  customers         Customer[]
  addresses         Address[]
  categories        Category[]
  products          Product[]
  images            ProductImage[]
  variants          Variant[]
  orders            Order[]
  orderItems        OrderItem[]
  settings          StoreSetting[]
}

model StoreMember {
  storeId   String
  accountId String
  role      MemberRole
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([storeId, accountId])
  @@index([accountId])
}

model StoreDomain {
  id       String  @id @default(cuid())
  storeId  String
  host     String  @unique
  verified Boolean @default(false)
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Subscription {
  id               String    @id @default(cuid())
  storeId          String    @unique
  status           SubStatus
  mpPreapprovalId  String?   @unique
  currentPeriodEnd DateTime?
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ---------- loja (todos com storeId) ----------

model Customer {
  id           String    @id @default(cuid())
  storeId      String
  name         String
  email        String
  cpf          String
  phone        String
  passwordHash String
  createdAt    DateTime  @default(now())
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses    Address[]
  orders       Order[]

  @@unique([storeId, email])
  @@unique([storeId, id])
}

model Address {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  cep        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
}

model Category {
  id       String     @id @default(cuid())
  storeId  String
  parentId String?
  slug     String
  name     String
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [storeId, parentId], references: [storeId, id], onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@unique([storeId, id])
  @@index([parentId])
}

model Product {
  id          String         @id @default(cuid())
  storeId     String
  categoryId  String?
  slug        String
  name        String
  description String         @default("")
  weightGrams Int
  heightCm    Int
  widthCm     Int
  lengthCm    Int
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [storeId, categoryId], references: [storeId, id], onDelete: NoAction)
  images      ProductImage[]
  variants    Variant[]

  @@unique([storeId, slug])
  @@unique([storeId, id])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  url       String
  color     String?
  position  Int     @default(0)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

// CHECK (stock >= 0) vive no SQL da migration (Prisma nao expressa).
// FKs filhos sao compostos (storeId, pai) -> (storeId, id): o banco impede referencia entre lojas.
// FKs opcionais compostos (Product.categoryId, OrderItem.variantId, Category.parentId) usam NoAction:
// SetNull tentaria anular storeId (NOT NULL). Consequencia: Variant com historico de pedidos nao
// pode ser apagada (use active=false) e Category com produtos/filhas nao pode ser apagada.
model Variant {
  id         String      @id @default(cuid())
  storeId    String
  productId  String
  sku        String
  color      String
  size       String
  priceCents Int
  stock      Int         @default(0)
  active     Boolean     @default(true)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@unique([productId, color, size])
  @@unique([storeId, id])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  customerId      String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  shippingService String
  trackingCode    String?
  addressSnapshot Json
  mpPaymentId     String?     @unique
  pixQrCode       String?
  pixExpiresAt    DateTime?
  /// Valor cobrado no Pix quando o QR foi criado (o desconto da loja pode mudar depois).
  pixAmountCents  Int?
  idempotencyKey  String?
  createdAt       DateTime    @default(now())
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // NoAction de proposito: historico de pedidos protegido (cliente com pedidos nao e apagado).
  customer        Customer    @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: NoAction)
  items           OrderItem[]

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id             String   @id @default(cuid())
  storeId        String
  orderId        String
  variantId      String?
  productName    String
  sku            String
  color          String
  size           String
  unitPriceCents Int
  quantity       Int
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)
  variant        Variant? @relation(fields: [storeId, variantId], references: [storeId, id], onDelete: NoAction)

  @@index([storeId])
  @@index([orderId])
  @@index([variantId])
}

model StoreSetting {
  storeId String
  key     String
  value   String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, key])
}
